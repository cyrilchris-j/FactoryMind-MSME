rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === HELPERS ===
    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }

    function role() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function userFactoryId() {
      let data = getUserData();
      return data != null ? data.factoryId : null;
    }

    function isOwner() {
      return isAuth() && role() == 'OWNER';
    }

    function isSameFactory(factoryId) {
      return isAuth() && userFactoryId() == factoryId;
    }

    // === USERS ===
    // Users can read/write their own document.
    // OWNER can read other users in the same factory.
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId
        || (isOwner() && isSameFactory(resource.data.factoryId))
      );
      
      // Allow creation of own profile during sign-up
      allow create: if isAuth() && request.auth.uid == userId;
      
      // Allow self-updates but prevent role escalation, factory ID manipulation, or changing creation date
      allow update: if isAuth() && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'factoryId', 'createdAt'])
      );
      
      // Owner can remove users of their factory, and users can delete their own accounts
      allow delete: if isAuth() && (
        request.auth.uid == userId 
        || (isOwner() && isSameFactory(resource.data.factoryId))
      );
    }

    // === FACTORIES ===
    // Direct client writes are not allowed. Read is allowed if authenticated and matching factory ID.
    match /factories/{fid} {
      allow read: if isAuth() && userFactoryId() == fid;
      allow write: if false;
    }

    // === COLLECTIONS IN THE SAME FACTORY ===
    // Client SDK can read data belonging to their factory.
    // Client SDK cannot perform direct writes (create/update/delete) as they must go through Backend API validation.
    match /machines/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /workers/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /production/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /inventory/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /maintenance/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /energy/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /sales/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /notifications/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /machine_daily_production/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /machine_suggestions/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /products/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /bill_of_materials/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /components/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }

    match /customer_orders/{doc} {
      allow read: if isSameFactory(resource.data.factoryId);
      allow write: if false;
    }
  }
}
